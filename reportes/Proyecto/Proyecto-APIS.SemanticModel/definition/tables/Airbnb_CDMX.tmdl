table Airbnb_CDMX
	lineageTag: c1d001ec-9eb8-4899-9f6f-28dad42958b3

	measure 'Número de anuncios Airbnb' = DISTINCTCOUNT(Airbnb_CDMX[listing_id])
		formatString: 0
		lineageTag: ae95eacf-8a31-4519-8871-431820464581

	measure 'Anuncios Airbnb' = DISTINCTCOUNT(Airbnb_CDMX[listing_id])
		formatString: 0.000
		lineageTag: a30a303d-23ab-424b-bbb7-fb9b70a16615

	measure 'Anfitriones únicos' = DISTINCTCOUNT(Airbnb_CDMX[host_id])
		formatString: 0
		lineageTag: 9166256e-6968-4e7e-a61b-4f799e82a211

	measure 'Alojamiento completo %' =
			
			DIVIDE(
			    CALCULATE([Anuncios Airbnb], Airbnb_CDMX[alojamiento_completo] = TRUE()),
			    [Anuncios Airbnb]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 703f27ca-ecdf-44a0-9e18-0cc8e7cf5bcc

		changedProperty = IsHidden

	measure 'Anuncios de anfitriones 3+' =
			
			CALCULATE(
			    [Anuncios Airbnb],
			    'Airbnb_CDMX'[host_3mas_anuncios_cdmx] = TRUE()
			)
		formatString: 0
		lineageTag: b58b04aa-deda-487f-b2e2-b30cf75eb99f

	measure 'Anuncios host 3+ %' =
			
			DIVIDE(
			    [Anuncios de anfitriones 3+],
			    [Anuncios Airbnb]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: db036cf2-513b-4f53-942c-547069137f39

	measure 'Precio mediano por noche MXN' =
			
			CALCULATE(
			    MEDIAN('Airbnb_CDMX'[precio_noche_mxn]),
			    'Airbnb_CDMX'[cotizacion_disponible] = TRUE(),
			    'Airbnb_CDMX'[cotizacion_mensualizada] = FALSE()
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: f83971c0-6aca-4917-9352-cafe65c4219b

	measure 'Anuncios con mínimo registrado' =
			
			CALCULATE(
			    DISTINCTCOUNT('Airbnb_CDMX'[listing_id]),
			    FILTER(
			        'Airbnb_CDMX',
			        NOT(ISBLANK('Airbnb_CDMX'[estancia_minima_noches]))
			    )
			)
		formatString: 0
		lineageTag: 215aa52a-bc89-48cf-9a2e-517236837800

	measure 'Anuncios con mínimo de 7 noches o menos' =
			
			CALCULATE(
			    DISTINCTCOUNT('Airbnb_CDMX'[listing_id]),
			    FILTER(
			        'Airbnb_CDMX',
			        NOT(ISBLANK('Airbnb_CDMX'[estancia_minima_noches]))
			            && 'Airbnb_CDMX'[estancia_minima_noches] <= 7
			    )
			)
		formatString: 0
		lineageTag: 4f428e3d-c72d-4385-a752-dc7e9c00deaf

	measure 'Porcentaje con mínimo de 7 noches o menos' =
			
			DIVIDE(
			    [Anuncios con mínimo de 7 noches o menos],
			    [Anuncios con mínimo registrado]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 01b68f20-4436-4188-98d4-e83851225668

